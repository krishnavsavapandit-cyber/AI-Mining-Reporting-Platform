# SIH26023 - AI-Powered Geological, Mining and Reporting Solution for CMPDI / CIL
# Configuration & Environment Variables (Placeholders Only - Never Commit Secrets)

# Application Settings
FLASK_ENV=development
FLASK_APP=app.py
PORT=5000
SECRET_KEY=sih26023-coal-india-secret-key-2026

# ==============================================================================
# Database Configuration (PostgreSQL Primary + SQLite Local Fallback)
# ==============================================================================
# 1. Default (SQLite Local Fallback - zero configuration required):
# Leave DATABASE_URL commented out or empty to use local SQLite:
# DATABASE_URL=sqlite:///database/mining_platform.db

# 2. Enterprise / Production (PostgreSQL Primary):
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sih26023

# AI Provider Configuration
# AI_PROVIDER: 'gemini' (default) or 'open_model' or 'deterministic'
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=open_model

# Primary Provider: Google Gemini API
# If left empty, system automatically falls back to OpenModel or Deterministic Grounded Engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fallback Provider: Open-Source / Open-Weight Model (Ollama / vLLM / HuggingFace / Local Endpoint)
OPEN_MODEL_ENDPOINT=http://localhost:11434/v1/chat/completions
OPEN_MODEL_API_KEY=
OPEN_MODEL_NAME=llama3.2:3b

# OCR Settings
TESSERACT_CMD=tesseract
OCR_ENGINE=auto
ADVANCED_OCR_ENABLED=true
OCR_MAX_PAGE_PIXELS=16000000
OCR_TIMEOUT_SECONDS=30
OCR_LANGUAGE=eng

# Vector Store & Embedding Settings
VECTOR_STORE_PATH=vector_store/index.pkl
EMBEDDING_DIMENSION=128

# File Upload Settings
MAX_CONTENT_LENGTH=52428800 # 50MB
UPLOAD_FOLDER=uploads
GENERATED_REPORTS_FOLDER=generated_reports
